@echo off
cd /d "%~dp0"
rem ============================================================
rem  Tile Downloader — клиент (отдельный проект)
rem  Получает задачи с сервера, скачивает тайлы, сдаёт их.
rem  Запуск:  client.bat [дополнительные аргументы]
rem  Адрес сервера: client.bat --server http://<host>:31059
rem  Несколько клиентов: несколько запусков (окон) с разными --client-id
rem  на разных машинах или на одной.
rem  Зависимости: если не установлены — сначала install.bat.
rem ============================================================
python client.py --server http://127.0.0.1:31059 --client-id %COMPUTERNAME% --threads 16 %*
pause
